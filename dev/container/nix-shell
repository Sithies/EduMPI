#!/usr/bin/env bash
# Ersatz für nix-shell: Die EduMPI-GUI sendet Jobs mit
#   nix-shell -p <pakete> --run "sbatch --parsable ./job.sh"
# ab. Hier gibt es kein Nix; alle Optionen außer --run werden ignoriert und der
# --run-Befehl wird direkt ausgeführt. Keine eigene Ausgabe: die GUI liest die Job-ID
# aus stdout.
cmd=""
while (( $# )); do
    case "$1" in
        --run) cmd="${2:-}"; shift 2 || shift ;;
        --run=*) cmd="${1#--run=}"; shift ;;
        *) shift ;;
    esac
done
if [[ -z "$cmd" ]]; then
    echo "nix-shell (EduMPI-Dev-Ersatz): nur 'nix-shell ... --run <befehl>' wird unterstützt" >&2
    exit 1
fi
exec bash -c "$cmd"
