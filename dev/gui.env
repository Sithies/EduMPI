# Werte des lokalen Dev-Clusters – eine Quelle für dev/compose.sh, dev/ssh/activate und den
# Dev-Modus der EduMPI-GUI (Auto-Connect). Nur öffentliche Dev-Werte, keine echten Zugangsdaten.
# Bereits gesetzte Umgebungsvariablen haben Vorrang (z. B. EDUMPI_DB_PORT=5433 dev/compose.sh up -d).

# Ports auf dem Rechner (compose.sh veröffentlicht sie, Wrapper und GUI nutzen sie)
EDUMPI_DEV_SSH_PORT=2222
EDUMPI_DB_PORT=5432

# Cluster-Verbindung der GUI (ssh läuft über dev/ssh/bin, daher der Host-Alias)
EDUMPI_DEV_CLUSTER_HOST=edumpi-dev
EDUMPI_DEV_CLUSTER_USER=dev
EDUMPI_DEV_EDUMPI_PATH=/opt/edumpi

# Datenbank-Verbindung der GUI (muss zu den POSTGRES_*-Werten in compose.yaml passen)
EDUMPI_DEV_DB_HOST=127.0.0.1
EDUMPI_DEV_DB_NAME=edumpi
EDUMPI_DEV_DB_USER=edumpi
EDUMPI_DEV_DB_PW=edumpi
